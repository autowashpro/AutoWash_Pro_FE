# Copy this file to .env.local and fill in the actual values.
# DO NOT commit .env.local to source control.

# --- API Configuration ---
# Backend .NET 8 dev server (Swagger: http://localhost:5255/swagger)
NEXT_PUBLIC_API_URL=http://localhost:5255/api

# --- Firebase Storage & Auth (autowashpro-12173) ---
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=autowashpro-12173.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=autowashpro-12173
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=autowashpro-12173.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=651490299814
NEXT_PUBLIC_FIREBASE_APP_ID=1:651490299814:web:f1030459d5a0b693e54967

